{
  "name": "wooo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter wooo-cli dev",
    "dev:cli": "bun run --filter wooo-cli dev",
    "dev:docs": "bun run --filter @wooo/docs dev",
    "build": "bun run --filter '*' build",
    "build:cli": "bun run --filter wooo-cli build",
    "build:docs": "bun run --filter @wooo/docs build",
    "type-check": "bun run --filter '*' type-check",
    "type-check:cli": "bun run --filter wooo-cli type-check",
    "type-check:docs": "bun run --filter @wooo/docs type-check",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "test": "bun run --filter wooo-cli test",
    "test:e2e": "bun run --filter wooo-cli test:e2e",
    "test:e2e:anvil": "bun run --filter wooo-cli test:e2e:anvil",
    "test:e2e:local": "bun run --filter wooo-cli test:e2e:local",
    "ci:check": "bun run lint:fix && bun run lint && bun run type-check && bun run build && bun run test",
    "package:check": "bun run --filter wooo-cli package:check",
    "release:verify": "bun run ci:check && bun run package:check",
    "release:verify:full": "bun run release:verify && bun run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "@types/node": "^25.4.0",
    "typescript": "^6.0.3"
  }
}
